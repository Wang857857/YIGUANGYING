/* <!-- pages/menu/menu.wxss --> */
.menu-page {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f8f6f6d2;
  overflow: hidden;
  box-sizing: border-box;
}

/* 顶部栏 */
.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #ffffff;
  color: #080808;
  height: 130rpx;
  min-height: 130rpx;
  max-height: 130rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.top-left {
  /* 新增：flex布局，图标+文字水平居中 */
  display: flex;
  align-items: center;
  gap: 12rpx; /* 图标和文字的间距，可自行调整 */
}

/* 新增：餐厅图标样式 */
.store-icon {
  width: 85rpx;
  height: 85rpx;
  margin: 18rpx;
}

.top-left .store-name {
  font-size: 36rpx;
  font-weight: 600;
}

.top-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.top-right .table-number {
  font-size: 26rpx;
}

.cart-box {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 购物车图标外层 */
.cart-icon-wrap {
  position: relative; /* 关键：让角标相对于图标定位 */
  display: flex;
  align-items: center;
  margin-right: 15rpx;
}

/* 购物车图标大小 */
.cart-icon {
  width: 50rpx;
  height: 50rpx;
}

/* 数字角标 —— 放在图标右上角 */
.cart-badge {
  position: absolute;
  top: -6rpx;    /* 向上一点 */
  right: -6rpx;  /* 向右一点 */
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  background: #ff4d4f;
  color: #fff;
  font-size: 20rpx;
  border-radius: 50%;
  text-align: center;
  z-index: 100;
  padding: 0 2rpx;
}


.search-bar {
  padding: 15rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  flex-shrink: 0;
  min-height: 90rpx;
  box-sizing: border-box;
}
.search-input {
  height: 72rpx;
  background: #f8f8f8;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.search-text {
  font-size: 28rpx;
  color: #999;
}

/* 搜索弹窗遮罩 */
.search-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  z-index: 997;
}

/* 搜索弹窗容器 */
.search-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  background: #fff;
  z-index: 998;
  padding: 20rpx 30rpx;
  box-sizing: border-box;
  max-height: 80vh;
  overflow-y: auto;
}

/* 输入框+按钮容器 */
.search-input-wrap {
  position: relative;
  display: flex;
  align-items: center;
  background: #f8f8f8;
  border-radius: 36rpx;
  padding: 0 20rpx;
  height: 72rpx;
  margin-bottom: 30rpx;
}

.search-input-field {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  height: 100%;
}

/* 搜索关键字高亮红色 */
.item-name .highlight {
  color: #e4393c;
  font-weight: 500;
}
.search-clear {
  position: absolute;
  right: 80rpx;
  font-size: 32rpx;
  color: #999;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 搜索按钮样式 */
.search-btn {
  width: 120rpx;
  height: 56rpx;
  line-height: 56rpx;
  background: #e4393c;
  color: #fff;
  border-radius: 28rpx;
  font-size: 26rpx;
  padding: 0;
  margin-left: 10rpx;
}

/* 搜索结果样式 */
.search-result {
  margin-top: 10rpx;
}

.result-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 15rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid #eee;
}

.search-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 10rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.item-name {
  font-size: 28rpx;
  color: #333;
}

.item-price {
  font-size: 28rpx;
  color: #e4393c;
  font-weight: 500;
}

/* 无结果提示 */
.search-empty {
  text-align: center;
  color: #999;
  padding: 40rpx 0;
  font-size: 28rpx;
}

.main-content {
  flex: 1;
  display: flex;
  flex-shrink: 1;
  overflow: hidden;
}

/* 左侧分类 */
.left-category {
  width: 200rpx;
  background: #fff;
  height: 100%;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 25rpx 10rpx;
  border-bottom: 1rpx solid #f2f2f2;
}

.category-item.active {
  background: #eae9e9;
}

/* 图标样式 */
.category-icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 8rpx;
}
.icon-img {
  width: 100%;
  height: 100%;
}

.category-name {
  font-size: 26rpx;
  color: #666;
}
.category-item.active .category-name {
  color: #121212;
}

/* 右侧菜品列表 */
.right-dishes {
  flex: 1;
  padding: 20rpx 30rpx;
  /* 关键：底部加120rpx内边距，给购物车悬浮栏留出空间 */
  padding-bottom: 120rpx;
  height: 100%;
  background: #f8f6f6d2;
  box-sizing: border-box;
}

.dish-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  transition: background-color 0.3s ease;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

/* 高亮样式保留，无需修改 */
.dish-item.highlight {
  background-color: #fff2f2;
  border: 2rpx solid #e4393c;
  box-sizing: border-box;
  animation: highlight-fade 1.2s forwards;
}

@keyframes highlight-fade {
  0% {
    background-color: #fff2f2;
    border-color: #e4393c;
  }
  100% {
    background-color: #fff;
    border-color: transparent;
  }
}

.dish-info .dish-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.dish-name {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.dish-price {
  font-size: 28rpx;
  color: #e4393c;
}

.dish-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
  display: block;
}

/* 菜品底部操作区（核心：控制按钮布局） */
.dish-footer {
  display: flex;
  justify-content: flex-end;
  align-items: center;
}

/* 选规格按钮 */
.spec-btn {
  font-size: 26rpx;
  color: #e4393c;
  background: #fff2f2;
  padding: 10rpx 30rpx;
  border-radius: 40rpx;
  margin-right: 12rpx;
}

/* 加减按钮容器（无背景/无拉伸） */
.dish-footer > view {
  display: flex;
  align-items: center;
  background: transparent;
  border: none;
  width: auto;
}

/* 减号按钮（配套样式） */
.dish-footer .btn-minus {
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  background: #f5f5f5;
  color: #999;
  font-size: 28rpx;
  border: 1rpx solid #eee;
  padding: 0;
  margin-right: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 数量文本 */
.dish-footer .quantity {
  font-size: 26rpx;
  color: #333;
  min-width: 30rpx;
  text-align: center;
  margin-right: 10rpx;
}

/* 加号按钮（匹配第二张图的圆角样式，无!important） */
.dish-footer .btn-plus {
  width: 80rpx;
  height: 40rpx;
  border-radius: 20rpx;
  background: #fff;
  color: #e4393c;
  font-size: 32rpx;
  border: 1rpx solid #e4393c;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

/* 去掉小程序按钮默认的边框和点击态 */
.btn-minus::after, .btn-plus::after {
  border: none;
}

/* 底部购物车悬浮栏 */
.bottom-cart-bar {
  position: fixed;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 100rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  padding: 0 30rpx;
  box-sizing: border-box;
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 左边：图标 + 合计 */
.cart-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

/* 购物车图标 */
.cart-icon {
  width: 50rpx;
  height: 50rpx;
}

/* 合计文字 */
.cart-total {
  font-size: 28rpx;
  color: #333;
}

/* 去结算按钮：靠右+变小 */
.settle-btn {
  width: auto;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 24rpx;
  padding: 0rpx;
  background: #e4393c;
  color: #fff;
  border-radius: 30rpx;
  margin-left: 0rpx;
}

.settle-btn::after {
  border: none;
}