/* 遮罩 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.5);
  z-index: 997;
}

.cart-modal {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: #ffffff !important;
  border-radius: 20rpx 20rpx 0 0;
  box-sizing: border-box;
  height: 60vh;
  display: flex;
  flex-direction: column;
  z-index: 998;
  transform: translateZ(0);
  -webkit-transform: translateZ(0);
}

/* 头部固定高度，禁止flex压缩 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background: #fff;
  flex-shrink: 0;
}

.cart-icon-modal {
  display: flex;
  align-items: center;
  gap: 20rpx;
  font-size: 32rpx;
  font-weight: 500;
  position: relative;
}
.cart-icon-modal image {
  width: 40rpx;
  height: 40rpx;
}

.cart-count-badge {
  position: absolute;
  top: -6rpx;
  left: 30rpx;
  background: #e4393c;
  color: #fff;
  font-size: 18rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.clear-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.clear-icon {
  width: 30rpx;
  height: 30rpx;
}
.clear {
  font-size: 26rpx;
  color: #999;
}
.close {
  font-size: 36rpx;
  color: #333;
}

/* 滚动容器核心流畅优化 */
.list {
  padding: 0 25rpx;
  flex: 1;
  overflow-y: auto;
  background: #fff;
  transform: translateZ(0);
  -webkit-transform: translateZ(0);
  overscroll-behavior: none;
  -webkit-overflow-scrolling: touch;
}

.empty {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 菜品项分层GPU渲染，减少重绘卡顿 */
.item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  width: 95%;
  box-sizing: border-box;
  background: #fff;
  transform: translateZ(0);
  -webkit-transform: translateZ(0);
}

.item-left {
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 30rpx;
  color: #222;
  margin-bottom: 8rpx;
}
.spec {
  font-size: 24rpx;
  color: #999;
  margin-left: 12rpx;
}
.remark {
  font-size: 24rpx;
  color: #666;
  margin-top: 12rpx;
  display: block;
}

.price-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
}
.price {
  font-size: 30rpx;
  color: #e4393c;
  font-weight: bold;
}
.tip-text {
  font-size: 22rpx;
  color: #999;
}

.counter {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-shrink: 0;
  width: 180rpx;
  gap: 8rpx;
}

.counter button {
  width: 20rpx;
  height: 50rpx;
  background: #f1f1f1;
  border: none;
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #333;
  flex-shrink: 0;
}

.counter text {
  min-width: 40rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
}

/* 底部固定高度，禁止压缩 */
.footer {
  padding: 24rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1rpx solid #f0f0f0;
  background: #fff;
  flex-shrink: 0;
}
.total {
  font-size: 32rpx;
  color: #e4393c;
  font-weight: bold;
}
.footer button {
  background: #e4393c;
  color: #fff;
  border-radius: 50rpx;
  padding: 16rpx 40rpx;
  font-size: 28rpx;
  border: none;
}