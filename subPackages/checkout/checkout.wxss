page {
  background-color: #f7f7f7;
  font-size: 28rpx;
  padding-bottom: 0;
  box-sizing: border-box;
}
.checkout-header {
  display: flex;
  align-items: center;
  height: 90rpx;
  background: #fff;
  padding: 0 20rpx;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
}
.back-btn {
  width: 140rpx;
  height: 60rpx;
  line-height: 60rpx;
  background: #e63946;
  color: #fff;
  text-align: center;
  border-radius: 30rpx;
}
/* 标题图标+文字横向布局 */
.header-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  justify-content: center;
}
.title-icon {
  width: 36rpx;
  height: 36rpx;
}
.header-title {
  font-size: 34rpx;
  font-weight: bold;
}
.empty-block {
  width: 140rpx;
}
/* 精准计算滚动高度：顶部90 + 底部footer高度 */
.food-scroll {
  height: calc(100vh - 90rpx - calc(130rpx + env(safe-area-inset-bottom)));
}
.food-list {
  background: #fff;
  margin: 20rpx;
  border-radius: 12rpx;
  padding: 20rpx;
}
/* 结算列表表头 */
.food-table-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #eee;
  gap: 30rpx;
  font-size: 28rpx;
  font-weight: bold; /* 粗体 */
  color: #000000; /* 纯黑色 */
}
.h-index {
  width: 50rpx;
  flex-shrink: 0;
  text-align: left;
  white-space: nowrap; /* 禁止文字换行，序号单行显示 */
}
.h-name {
  flex: 1;
  text-indent: -12rpx;
  padding-left: 12rpx;
  white-space: nowrap;
  /* text-align: center; */
}
.h-count {
  width: 70rpx;
  flex-shrink: 0;
  text-align: right;
  white-space: nowrap;
}
.h-price {
  width: 100rpx;
  flex-shrink: 0;
  text-align: right;
  white-space: nowrap;
}
.food-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  padding: 50rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
  gap: 30rpx;
}
.food-item:last-child {
  border-bottom: none;
}
.item-index {
  width: 50rpx;
  color: #666;
  text-align: left;
  flex-shrink: 0;
}
.item-name {
  flex: 1;
  color: #222;
  line-height: 1.5;
  text-indent: -12rpx;
  padding-left: 12rpx;
  /* text-align:center */
}
/* 称重提示文字样式 */
.weight-tip {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
  /* 取消居中，恢复左对齐 */
}
.item-count {
  width: 70rpx;
  text-align: right;
  color: #666;
  flex-shrink: 0;
}
.item-price {
  width: 100rpx;
  color: #e63946;
  font-weight: bold;
  text-align: right;
  flex-shrink: 0;
}
.remark-box {
  background: #fff;
  margin: 20rpx;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
}
.remark-title {
  display: block;
  margin-bottom: 16rpx;
  color: #333;
}
.remark-input {
  width: 100%;
  min-height: 60rpx;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  padding: 16rpx;
  box-sizing: border-box;
}
.checkout-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 130rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  box-sizing: border-box;
  border-top: 1rpx solid #eee;
  padding-bottom: env(safe-area-inset-bottom);
  height: calc(130rpx + env(safe-area-inset-bottom));
}
.total-text {
  flex: 1;
  font-size: 30rpx;
}
.total-price {
  color: #e63946;
  font-size: 36rpx;
  font-weight: bold;
}
.submit-order-btn {
  width: 240rpx;
  height: 80rpx;
  background: #e63946;
  color: #fff;
  border-radius: 40rpx;
  border: none;
  font-size: 28rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.success-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.success-modal {
  width: 600rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.success-text {
  font-size: 32rpx;
  color: #222;
  margin-bottom: 40rpx;
}
.modal-confirm-btn {
  width: 300rpx;
  background: #e63946;
  color: #fff;
  border-radius: 40rpx;
}