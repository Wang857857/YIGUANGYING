<!-- 顶部固定标题栏 -->
<view class="checkout-header">
  <view class="back-btn" bindtap="goBackMenu">返回</view>
  <!-- 新增图标+标题横向容器 -->
  <view class="header-title-wrap">
    <image src="/images/checkout/list.png" class="title-icon"></image>
    <view class="header-title">已点菜品</view>
  </view>
  <view class="empty-block"></view>
</view>

<!-- 滚动容器：内部仅两层容器，无独立裸空view -->
<scroll-view class="food-scroll" scroll-y>
  <view class="food-wrap">
    <!-- 菜品列表 -->
    <view class="food-list">
      <!-- 新增表头行 -->
      <view class="food-table-header">
        <text class="h-index">序号</text>
        <text class="h-name">菜品名称</text>
        <text class="h-count">数量</text>
        <text class="h-price">价格</text>
      </view>
      <view class="food-item" wx:for="{{cartList}}" wx:key="uniqueId">
        <text class="item-index">{{index + 1}}</text>
        <view class="item-name">
          {{item.foodName}}{{item.selectedSpec.name ? '(' + item.selectedSpec.name + ')' : ''}}
          <!-- 称重提示文字，仅isJinWeight=true显示 -->
          <text wx:if="{{item.weightTip}}" class="weight-tip">{{item.weightTip}}</text>
          <text wx:if="{{item.remark}}" style="display:block;color:#999;font-size:24rpx;margin-top:8rpx;">备注：{{item.remark}}</text>
        </view>
        <text class="item-count">×{{item.num}}</text>
        <!-- 改为绑定预生成好的价格文本，称重菜为空 -->
        <text class="item-price">{{item.showPriceText}}</text>
      </view>
    </view>
    <!-- 备注框，嵌套在统一外层容器内，不单独游离 -->
    <view class="remark-box">
      <text class="remark-title">订单备注</text>
      <textarea class="remark-input" placeholder="请输入整体备注（忌口、需求等）" bindinput="inputRemark" value="{{orderRemark}}"></textarea>
    </view>
  </view>
</scroll-view>

<!-- 底部固定结算栏 -->
<view class="checkout-footer">
  <view class="total-text">合计：<text class="total-price">¥{{totalAmount}}</text></view>
  <button class="submit-order-btn" bindtap="submitOrder">确认下单</button>
</view>

<!-- 弹窗遮罩 -->
<view class="success-mask" wx:if="{{showSuccessModal}}" bindtap="closeModal">
  <view class="success-modal">
    <text class="success-text">下单成功，请等待上菜！</text>
    <button class="modal-confirm-btn" bindtap="closeModal">知道了</button>
  </view>
</view>